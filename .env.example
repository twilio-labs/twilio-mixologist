# Lead collection mode: MANUAL (default) | NONE | QR
LEAD_COLLECTION=MANUAL
# Shown in verification emails (MANUAL mode)
EVENT_NAME=

# Optional: Segment Profiles enrichment
SEGMENT_SPACE_ID=
SEGMENT_PROFILE_KEY=
SEGMENT_TRAIT_CHECK=

